{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adnota",
  "version": "0.1.0",
  "identifier": "app.adnota.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @adnota/web dev",
    "beforeBuildCommand": "pnpm --filter @adnota/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Adnota",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Mindmap-first study notes",
    "longDescription": "A mindmap-first desktop app for taking study notes, with live LaTeX, images, and freehand drawing on the same canvas. Local-first, no account, no telemetry.",
    "copyright": "Copyright (c) 2026 Adnota contributors",
    "licenseFile": "../../LICENSE"
  },
  "plugins": {}
}